<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/grey"
    android:clickable="true"
    tools:context=".ui.order.OrderDetailsFragment">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        app:cardElevation="10dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp">

            <TextView
                android:id="@+id/orderIDTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:text="@string/order_details"
                android:textSize="22sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/separationImageView"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/orderIDTextView"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp"
                android:background="@color/purple_500"/>

            <LinearLayout
                android:id="@+id/verticalLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@+id/separationImageView">
            </LinearLayout>

            <TextView
                android:id="@+id/totalTextView"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/verticalLinearLayout"
                android:layout_marginTop="5dp"
                android:text="Total: €55"
                android:textStyle="bold"
                android:paddingLeft="15dp"
                android:gravity="left|center"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:background="@color/purple_500"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/finalizeOrderButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:text="@string/finalize_order_button"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@color/purple_500"/>

</RelativeLayout>