<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.app.wisepos.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.app.wisepos.ui.dashboard.PurchaseHistoryFragment"
        android:label="@string/title_purchase_history"
        tools:layout="@layout/fragment_purchase_history" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.app.wisepos.ui.catalog.CatalogFragment"
        android:label="@string/title_items_catalog"
        tools:layout="@layout/fragment_catalog" />
</navigation>